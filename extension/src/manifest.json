{
  "manifest_version": 3,
  "name": "TLC Attendance Sync",
  "version": "1.0.0",
  "description": "Syncs attendance from Supabase to Trail Life Connect",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.traillifeconnect.com/attendance*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.traillifeconnect.com/attendance*"],
      "js": ["src/content.js"]
    }
  ]
}
